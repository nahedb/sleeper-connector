{
  "name": "sleeper-mcp-connector",
  "version": "0.1.0",
  "description": "Read-only MCP connector for Sleeper fantasy football leagues. Works with any league - no credentials required.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sleeper-mcp": "dist/index.js",
    "sleeper-mcp-http": "dist/http.js"
  },
  "files": ["dist"],
  "engines": { "node": ">=20.12" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
