# Copy to .env (git-ignored) or set in your MCP client config.
# Everything here is OPTIONAL. Sleeper's API is public and read-only - no API key exists.

# Default league so you don't have to say it every time. Find it in your league URL:
#   https://sleeper.com/leagues/<LEAGUE_ID>/...
SLEEPER_LEAGUE_ID=

# Default Sleeper username (used by tools like "my leagues" / "my team").
SLEEPER_USERNAME=

# ---- Only for the HTTP server (npm run start:http) ----
# Host/port to bind. Defaults to 127.0.0.1:3000 (local only).
HOST=127.0.0.1
PORT=3000
# REQUIRED when HOST is not localhost. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Optional comma-separated list of allowed browser Origins (blank = reject any Origin header).
ALLOWED_ORIGINS=
