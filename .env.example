# Copy to .env (git-ignored) or set in your MCP client config.
# Everything here is OPTIONAL. Sleeper's API is public and read-only - no API key exists.

# Default league so you don't have to say it every time. Find it in your league URL:
#   https://sleeper.com/leagues/<LEAGUE_ID>/...
SLEEPER_LEAGUE_ID=

# Default Sleeper username (used by tools like "my leagues" / "my team").
SLEEPER_USERNAME=

# ---- Only for the HTTP server (npm run start:http) ----
# Host/port to bind. Defaults to 127.0.0.1:3000 (local only). Use 0.0.0.0 when deploying.
HOST=127.0.0.1
PORT=3000
# OPTIONAL. If set (>=32 chars, e.g. `openssl rand -hex 32`), every request needs
# "Authorization: Bearer <token>". Leave blank for Claude app connectors ("No sign-in").
MCP_AUTH_TOKEN=
# Requests per minute per client IP (always enforced).
RATE_LIMIT_PER_MIN=60
# Set to true ONLY behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Optional comma-separated list of allowed browser Origins (blank = reject any Origin header).
ALLOWED_ORIGINS=
